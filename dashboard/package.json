{
  "name": "minecraft-world-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "dev": "tsx watch server/main.ts",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s bridge -p 'test_*.py'",
    "lint": "eslint .",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:follow-browser": "node tests/follow-browser.mjs",
    "test:speech-browser": "node tests/speech-browser.mjs",
    "test:environment-browser": "node tests/environment-browser.mjs",
    "setup-map": "python3 bridge/remote.py setup",
    "sync-map": "python3 bridge/remote.py snapshot",
    "service": "node service.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.6.2",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
